# VDOIT — Apache / cPanel configuration
#
# The build prerenders every route to its own index.html (dist/services/index.html
# and so on), so there is NO single-page-app rewrite here and none is needed:
# each URL is an ordinary file on disk. What this file does is pick one
# canonical URL shape, serve extensionless paths, return a real 404, and set
# cache headers.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. One canonical origin: https, with www. Anything else is redirected once.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://www.vdoitech.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} !^www\.vdoitech\.com$ [NC]
  RewriteRule ^ https://www.vdoitech.com%{REQUEST_URI} [R=301,L]

  # 1b. /products was renamed to /success-stories. Permanent, so old links
  #     and anything already indexed still land.
  RewriteRule ^products/?$ /success-stories [R=301,L]

  # 2. No trailing slashes, to match the canonical tags the build emits.
  #    The leading `.+` means the bare root is left alone.
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [R=301,L]

  # 3. Serve /services from /services/index.html without redirecting to
  #    /services/. DirectorySlash is off so mod_dir will not add the slash back.
  DirectorySlash Off
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>

# A genuine 404 status. The site used to redirect unknown paths to the home
# page, which search engines read as a soft 404 and index as a duplicate.
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change under the same name.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must be revalidated or a deploy never reaches returning visitors.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # robots.txt, sitemap.xml and llms.txt are read by crawlers; a day is plenty.
  <FilesMatch "\.(txt|xml)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
